<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Upload Word, Excel, PowerPoint, HTML, Markdown, XPS, images, or PDF and merge them into one PDF." />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/34.2.8/material3.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.syncfusion.com/ej2/34.2.8/dist/ej2.min.js"></script>
    <link rel="icon" type="image/x-icon" href="~/favicon.svg">
</head>
<body>
    <ejs-appbar id="appbar" colorMode="Light" isSticky="true">
        <e-content-template>
            <a href="/" aria-label="Syncfusion">
                <div class="syncfusion-logo"></div>
            </a>
            <span class="appbar-title">Convert &amp; Merge Documents to PDF</span>
        </e-content-template>
    </ejs-appbar>
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
    <ejs-scripts></ejs-scripts>
</body>
</html>
