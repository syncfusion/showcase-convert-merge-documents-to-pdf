<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  
    <RuntimeIdentifier Condition="'$(PublishProfile)' != '' and '$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Syncfusion.Pdf.Net.Core" Version="*" />
    <PackageReference Include="Syncfusion.Pdf.Imaging.Net.Core" Version="*" />
    <PackageReference Include="Syncfusion.DocIORenderer.Net.Core" Version="*" />
    <PackageReference Include="Syncfusion.XlsIORenderer.Net.Core" Version="*" />
    <PackageReference Include="Syncfusion.PresentationRenderer.Net.Core" Version="*"/>
    <PackageReference Include="Syncfusion.HtmlToPdfConverter.Net.Windows" Version="*" Condition="!$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))" />
    <PackageReference Include="Syncfusion.HtmlToPdfConverter.Net.Linux" Version="*" Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux'))" />
    <PackageReference Include="Syncfusion.XpsToPdfConverter.Net.Core" Version="*" />
    <!-- For Linux runtime environment -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="dependenciesInstall.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
